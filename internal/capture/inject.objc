// Injected into a Metal target to start a capture the target never asks for.
//
// Starting in a constructor is incorrect for interpreter launchers: an exec
// loads this image again, so the launcher creates the output bundle and the
// process that submits Metal work then loses a race with that stale bundle.
// Interpose device creation instead. The process that first asks for a Metal
// device atomically claims GT_CAPTURE_LOCK and starts the capture before the
// device is returned to its caller.
#import <Metal/Metal.h>
#import <Foundation/Foundation.h>
#import <objc/runtime.h>
#include <errno.h>
#include <fcntl.h>
#include <mach-o/dyld.h>
#include <stdatomic.h>
#include <stdint.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <sys/file.h>
#include <unistd.h>

static _Atomic int gputrace_attempted;
static _Atomic uint64_t gputrace_command_buffer_id;
static int gputrace_capturing;
static id<MTLDevice> gputrace_device;
static IMP gputrace_new_command_queue_original;
static IMP gputrace_new_command_queue_max_original;
static IMP gputrace_new_command_queue_descriptor_original;
static IMP gputrace_command_buffer_original;
static IMP gputrace_command_buffer_unretained_original;
static IMP gputrace_command_buffer_descriptor_original;
static char gputrace_observed_key;
static char gputrace_queue_hooked_key;
static char gputrace_device_hooked_key;

static void gputrace_write_json(NSDictionary *record) {
	const char *path = getenv("GT_TIMING_OUT");
	if (path == NULL) {
		return;
	}
	NSMutableDictionary *envelope = [record mutableCopy];
	const char *run = getenv("GPUTRACE_RUN_ID");
	if (run != NULL) {
		envelope[@"run_id"] = @(run);
	}
	NSError *err = nil;
	NSData *data = [NSJSONSerialization dataWithJSONObject:envelope
	                                                options:0 error:&err];
	if (data == nil) {
		fprintf(stderr, "gputrace: encode timing sidecar: %s\n",
		        err.localizedDescription.UTF8String);
		return;
	}
	int fd = open(path, O_WRONLY | O_CREAT | O_APPEND | O_CLOEXEC, 0600);
	if (fd < 0) {
		fprintf(stderr, "gputrace: open timing sidecar: %s\n", strerror(errno));
		return;
	}
	(void)flock(fd, LOCK_EX);
	(void)write(fd, data.bytes, data.length);
	(void)write(fd, "\n", 1);
	(void)flock(fd, LOCK_UN);
	close(fd);
}

static void gputrace_sample_clocks(void) {
	if (gputrace_device == nil ||
	    ![gputrace_device respondsToSelector:@selector(sampleTimestamps:gpuTimestamp:)]) {
		return;
	}
	MTLTimestamp cpu = 0, gpu = 0;
	[gputrace_device sampleTimestamps:&cpu gpuTimestamp:&gpu];
	gputrace_write_json(@{
		@"kind": @"clock_sample",
		@"cpu_ticks": @(cpu),
		@"gpu_ticks": @(gpu),
	});
}

static id<MTLCommandBuffer> gputrace_observe_buffer(id<MTLCommandBuffer> buffer) {
	if (buffer == nil || getenv("GT_TIMING_OUT") == NULL) {
		return buffer;
	}
	if (objc_getAssociatedObject(buffer, &gputrace_observed_key) != nil) {
		return buffer;
	}
	objc_setAssociatedObject(buffer, &gputrace_observed_key, @YES,
	                         OBJC_ASSOCIATION_RETAIN_NONATOMIC);
	uint64_t identifier = atomic_fetch_add(&gputrace_command_buffer_id, 1) + 1;
	NSString *label = [NSString stringWithFormat:@"gputrace.live.cb.%llu",
	                   (unsigned long long)identifier];
	buffer.label = label;
	gputrace_sample_clocks();
	[buffer addCompletedHandler:^(id<MTLCommandBuffer> completed) {
		gputrace_sample_clocks();
		gputrace_write_json(@{
			@"kind": @"command_buffer",
			@"id": @(identifier),
			@"capture_label": label,
			@"final_label": completed.label ?: label,
			@"gpu_start_seconds": @(completed.GPUStartTime),
			@"gpu_end_seconds": @(completed.GPUEndTime),
			@"kernel_start_seconds": @(completed.kernelStartTime),
			@"kernel_end_seconds": @(completed.kernelEndTime),
			@"status": @((NSInteger)completed.status),
		});
	}];
	return buffer;
}

static id<MTLCommandBuffer> gputrace_command_buffer(id self, SEL command) {
	id<MTLCommandBuffer> (*original)(id, SEL) =
	    (id<MTLCommandBuffer> (*)(id, SEL))gputrace_command_buffer_original;
	return gputrace_observe_buffer(original(self, command));
}

static id<MTLCommandBuffer> gputrace_command_buffer_unretained(id self,
                                                               SEL command) {
	id<MTLCommandBuffer> (*original)(id, SEL) =
	    (id<MTLCommandBuffer> (*)(id, SEL))gputrace_command_buffer_unretained_original;
	return gputrace_observe_buffer(original(self, command));
}

static id<MTLCommandBuffer> gputrace_command_buffer_descriptor(
    id self, SEL command, MTLCommandBufferDescriptor *descriptor) {
	id<MTLCommandBuffer> (*original)(id, SEL, MTLCommandBufferDescriptor *) =
	    (id<MTLCommandBuffer> (*)(id, SEL, MTLCommandBufferDescriptor *))
	        gputrace_command_buffer_descriptor_original;
	return gputrace_observe_buffer(original(self, command, descriptor));
}

static void gputrace_replace(Class cls, SEL selector, IMP replacement,
                             IMP *original) {
	Method method = class_getInstanceMethod(cls, selector);
	if (method == NULL) {
		return;
	}
	*original = method_getImplementation(method);
	class_replaceMethod(cls, selector, replacement, method_getTypeEncoding(method));
}

static void gputrace_hook_queue(id<MTLCommandQueue> queue) {
	if (queue == nil) {
		return;
	}
	Class cls = object_getClass(queue);
	if (objc_getAssociatedObject(cls, &gputrace_queue_hooked_key) != nil) {
		return;
	}
	objc_setAssociatedObject(cls, &gputrace_queue_hooked_key, @YES,
	                         OBJC_ASSOCIATION_RETAIN_NONATOMIC);
	gputrace_replace(cls, @selector(commandBuffer), (IMP)gputrace_command_buffer,
	                 &gputrace_command_buffer_original);
	gputrace_replace(cls, @selector(commandBufferWithUnretainedReferences),
	                 (IMP)gputrace_command_buffer_unretained,
	                 &gputrace_command_buffer_unretained_original);
	gputrace_replace(cls, @selector(commandBufferWithDescriptor:),
	                 (IMP)gputrace_command_buffer_descriptor,
	                 &gputrace_command_buffer_descriptor_original);
}

static id<MTLCommandQueue> gputrace_new_command_queue(id self, SEL command) {
	id<MTLCommandQueue> (*original)(id, SEL) =
	    (id<MTLCommandQueue> (*)(id, SEL))gputrace_new_command_queue_original;
	id<MTLCommandQueue> queue = original(self, command);
	gputrace_hook_queue(queue);
	return queue;
}

static id<MTLCommandQueue> gputrace_new_command_queue_max(id self, SEL command,
                                                          NSUInteger count) {
	id<MTLCommandQueue> (*original)(id, SEL, NSUInteger) =
	    (id<MTLCommandQueue> (*)(id, SEL, NSUInteger))gputrace_new_command_queue_max_original;
	id<MTLCommandQueue> queue = original(self, command, count);
	gputrace_hook_queue(queue);
	return queue;
}

static id<MTLCommandQueue> gputrace_new_command_queue_descriptor(
    id self, SEL command, MTLCommandQueueDescriptor *descriptor) {
	id<MTLCommandQueue> (*original)(id, SEL, MTLCommandQueueDescriptor *) =
	    (id<MTLCommandQueue> (*)(id, SEL, MTLCommandQueueDescriptor *))
	        gputrace_new_command_queue_descriptor_original;
	id<MTLCommandQueue> queue = original(self, command, descriptor);
	gputrace_hook_queue(queue);
	return queue;
}

static void gputrace_hook_device(id<MTLDevice> device) {
	if (device == nil || getenv("GT_TIMING_OUT") == NULL) {
		return;
	}
	gputrace_device = device;
	Class cls = object_getClass(device);
	if (objc_getAssociatedObject(cls, &gputrace_device_hooked_key) != nil) {
		return;
	}
	objc_setAssociatedObject(cls, &gputrace_device_hooked_key, @YES,
	                         OBJC_ASSOCIATION_RETAIN_NONATOMIC);
	gputrace_replace(cls, @selector(newCommandQueue),
	                 (IMP)gputrace_new_command_queue,
	                 &gputrace_new_command_queue_original);
	gputrace_replace(cls, @selector(newCommandQueueWithMaxCommandBufferCount:),
	                 (IMP)gputrace_new_command_queue_max,
	                 &gputrace_new_command_queue_max_original);
	gputrace_replace(cls, @selector(newCommandQueueWithDescriptor:),
	                 (IMP)gputrace_new_command_queue_descriptor,
	                 &gputrace_new_command_queue_descriptor_original);
	gputrace_sample_clocks();
}

static void gputrace_stop(void) {
	if (gputrace_capturing) {
		[[MTLCaptureManager sharedCaptureManager] stopCapture];
	}
}

static int gputrace_elect(void) {
	char fallback[4096];
	const char *lock = getenv("GT_CAPTURE_LOCK");
	if (lock == NULL) {
		const char *out = getenv("GT_TRACE_OUT");
		int n = out == NULL ? -1 :
		    snprintf(fallback, sizeof fallback, "%s.capture-lock", out);
		if (n < 0 || (size_t)n >= sizeof fallback) {
			fprintf(stderr, "gputrace: capture lock path unavailable\n");
			return 0;
		}
		lock = fallback;
	}
	int fd = open(lock, O_WRONLY | O_CREAT | O_EXCL | O_CLOEXEC, 0600);
	if (fd < 0) {
		if (errno != EEXIST) {
			fprintf(stderr, "gputrace: create capture lock: %s\n",
			        strerror(errno));
		}
		return 0;
	}

	char exe[4096];
	uint32_t size = sizeof exe;
	if (_NSGetExecutablePath(exe, &size) == 0) {
		dprintf(fd, "%d\t%s\n", getpid(), exe);
	} else {
		dprintf(fd, "%d\n", getpid());
	}
	close(fd);
	return 1;
}

static void gputrace_start(id<MTLDevice> dev) {
	int expected = 0;
	if (dev == nil || !atomic_compare_exchange_strong(&gputrace_attempted,
	                                                  &expected, 1)) {
		return;
	}
	if (!gputrace_elect()) {
		return;
	}
	gputrace_hook_device(dev);

	@autoreleasepool {
		const char *out = getenv("GT_TRACE_OUT");
		if (out == NULL) {
			return;
		}
		MTLCaptureManager *cm = [MTLCaptureManager sharedCaptureManager];
		if (![cm supportsDestination:MTLCaptureDestinationGPUTraceDocument]) {
			fprintf(stderr, "gputrace: GPU trace documents unsupported; "
			                "is MTL_CAPTURE_ENABLED set?\n");
			return;
		}
		MTLCaptureDescriptor *d = [MTLCaptureDescriptor new];
		d.captureObject = dev;
		d.destination = MTLCaptureDestinationGPUTraceDocument;
		d.outputURL = [NSURL fileURLWithPath:@(out)];

		NSError *err = nil;
		if (![cm startCaptureWithDescriptor:d error:&err]) {
			fprintf(stderr, "gputrace: startCapture: %s\n",
			        err.localizedDescription.UTF8String);
			return;
		}
		gputrace_capturing = 1;
		atexit(gputrace_stop);
		fprintf(stderr, "gputrace: capture started in pid %d\n", getpid());
	}
}

static id<MTLDevice> gputrace_create_system_default_device(void)
    NS_RETURNS_RETAINED;
static id<MTLDevice> gputrace_create_system_default_device(void) {
	id<MTLDevice> dev = MTLCreateSystemDefaultDevice();
	gputrace_start(dev);
	return dev;
}

static NSArray<id<MTLDevice>> *gputrace_copy_all_devices(void)
    NS_RETURNS_RETAINED;
static NSArray<id<MTLDevice>> *gputrace_copy_all_devices(void) {
	NSArray<id<MTLDevice>> *devices = MTLCopyAllDevices();
	gputrace_start(devices.firstObject);
	return devices;
}

static NSArray<id<MTLDevice>> *gputrace_copy_all_devices_with_observer(
    id<NSObject> __strong *observer, MTLDeviceNotificationHandler handler)
    NS_RETURNS_RETAINED;
static NSArray<id<MTLDevice>> *gputrace_copy_all_devices_with_observer(
    id<NSObject> __strong *observer, MTLDeviceNotificationHandler handler) {
	NSArray<id<MTLDevice>> *devices =
	    MTLCopyAllDevicesWithObserver(observer, handler);
	gputrace_start(devices.firstObject);
	return devices;
}

#define DYLD_INTERPOSE(replacement, replacee)                              \
	__attribute__((used)) static struct {                                \
		const void *replacement;                                       \
		const void *replacee;                                          \
	} interpose_##replacee __attribute__((section("__DATA,__interpose"))) = { \
		(const void *)(uintptr_t)&replacement,                         \
		(const void *)(uintptr_t)&replacee,                            \
	}

DYLD_INTERPOSE(gputrace_create_system_default_device,
               MTLCreateSystemDefaultDevice);
DYLD_INTERPOSE(gputrace_copy_all_devices, MTLCopyAllDevices);
DYLD_INTERPOSE(gputrace_copy_all_devices_with_observer,
               MTLCopyAllDevicesWithObserver);
